# Standard Unity .gitignore. Patterns use [Ll]ibrary/ style so they match
# whether the Unity project is at the repo root or nested one level down
# (e.g. tactical-storm-game/TacticalStormGame/).

# --- Unity generated / local ---
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta files must NOT be ignored when their asset is tracked
!/[Aa]ssets/**/[Ll]ibrary/
!/[Aa]ssets/**/[Ll]ocal[Cc]ache/

# --- IDE / editor ---
# Note: .vscode/ and .idea/ are intentionally NOT ignored - some devs commit
# shared debug/launch configs. Only genuinely-generated editor caches are listed.
.vs/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
ExportedObj/

# --- Build artifacts / packages ---
*.apk
*.aab
*.app
*.unitypackage
*.tmp
crashlytics-build.properties
sysinfo.txt

# --- OS cruft ---
.DS_Store
Thumbs.db
